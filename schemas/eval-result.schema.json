{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://everyone-is-skill.dev/schemas/eval-result.schema.json",
  "title": "Evaluation Result",
  "description": "Evaluation specification and executed-result format used by everyone-skill run-evals. Draft templates may omit execution metadata until cases are run.",
  "type": "object",
  "required": [
    "status",
    "cases"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "not-run",
        "specified",
        "in-progress",
        "passed",
        "failed",
        "mixed"
      ]
    },
    "schema_version": {
      "type": "string"
    },
    "suite": {
      "type": "string"
    },
    "executed_at": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "source_snapshot": {
      "type": "string"
    },
    "rubric_version": {
      "type": "string"
    },
    "rubric": {
      "type": "object"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string"
          },
          "held_out_window": {
            "type": "string"
          },
          "expected": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbidden": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbidden_reasons": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "candidate_output": {
            "type": "string"
          },
          "minimum_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "prompt_sha256": {
            "type": "string"
          },
          "raw_output_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "run_id": {
            "type": "string"
          },
          "case_kind": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "method_fidelity_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "identity_boundary_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "raw_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "failure_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verdict": {
            "type": "string",
            "enum": [
              "passed",
              "failed"
            ]
          },
          "result": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
