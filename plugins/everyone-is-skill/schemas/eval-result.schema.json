{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://everyone-is-skill.dev/schemas/eval-result.schema.json",
  "title": "Evaluation Result",
  "description": "Advisory schema for eval result files. Current runtime does not validate these values, so only a small inert shape is required by templates.",
  "type": "object",
  "required": [
    "status",
    "cases"
  ],
  "properties": {
    "status": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string"
          },
          "held_out_window": {
            "type": "string"
          },
          "expected": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbidden": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "result": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
